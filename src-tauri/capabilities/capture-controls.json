{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture-controls",
  "description": "Allow the capture control title bars to handle native dragging and double clicks.",
  "windows": ["scroll", "record"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
